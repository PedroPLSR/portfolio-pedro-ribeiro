# Copy to docker/.env and adjust. Never commit docker/.env.

# MySQL
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_PORT=3306

# WordPress (host → container)
WORDPRESS_PORT=8080

# phpMyAdmin (local profile only — not for production)
PHPMYADMIN_PORT=8081

# Now integrations (Phase E). Keep out of ACF / admin content fields.
# Theme bootstrap maps this env var to the LASTFM_API_KEY PHP constant when unset in wp-config.
# Do not add API secrets to ACF field groups.
LASTFM_API_KEY=
